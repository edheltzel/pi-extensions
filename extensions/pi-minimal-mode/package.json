{
  "name": "@edheltzel/pi-minimal-mode",
  "version": "0.0.0",
  "private": true,
  "description": "Compact built-in Pi tool rendering with full output for mutations and unsafe shell commands",
  "keywords": [
    "extension",
    "minimal",
    "pi",
    "pi-coding-agent",
    "pi-package",
    "tui"
  ],
  "homepage": "https://github.com/edheltzel/pi-extensions/tree/master/extensions/pi-minimal-mode#readme",
  "contributors": [
    {
      "name": "Virgil Bulens",
      "url": "https://github.com/Virgil-Bulens"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edheltzel/pi-extensions.git",
    "directory": "extensions/pi-minimal-mode"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest --run --root ../.. extensions/pi-minimal-mode/tests",
    "test:watch": "vitest --root ../.. extensions/pi-minimal-mode/tests",
    "tsc": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
