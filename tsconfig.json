{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@edheltzel/pi-background-bash": ["./extensions/background-bash/src/extension.ts"],
      "@edheltzel/pi-background-bash/core": ["./extensions/background-bash/src/core.ts"],
      "@edheltzel/pi-context-commands": ["./extensions/context-commands/src/extension.ts"],
      "@edheltzel/pi-tmux-bash": ["./extensions/tmux-bash/src/extension.ts"],
      "@edheltzel/pi-tmux-bash/core": ["./extensions/tmux-bash/src/core.ts"],
      "@edheltzel/pi-file-collector": ["./extensions/file-collector/src/extension.ts"],
      "@edheltzel/pi-project-resources": ["./extensions/project-resources/src/index.ts"],
      "@edheltzel/pi-parrot": ["./extensions/parrot/src/extension.ts"],
      "@edheltzel/pi-preset": ["./extensions/preset/src/extension.ts"],
      "@edheltzel/pi-sub-pi": ["./extensions/sub-pi/src/extension.ts"],
      "@edheltzel/pi-sub-pi-skill": ["./extensions/sub-pi-skill/src/extension.ts"],
      "@edheltzel/pi-skill-metadata-templates": [
        "./extensions/skill-metadata-templates/src/extension.ts"
      ],
      "pi-bash-timeout-guard": ["./extensions/bash-timeout-guard/src/extension.ts"],
      "@edheltzel/pi-up-history": ["./extensions/pi-up-history/src/extension.ts"],
      "@edheltzel/pi-config": ["./packages/pi-config/src/index.ts"],
      "@edheltzel/pi-zod-tool-call": ["./packages/pi-zod-tool-call/src/index.ts"],
      "@edheltzel/lib": ["./packages/lib/src/index.ts"]
    }
  },
  "include": [
    "index.ts",
    "extensions/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ]
}
